    "@types/three": "^0.166.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "playwright": "1.61.1",
    "prettier": "^3.9.6",
    "typescript": "^5.5.0",
